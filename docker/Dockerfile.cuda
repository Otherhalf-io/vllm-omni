ARG BASE_IMAGE=docker.io/vllm/vllm-openai@sha256:ffb2d59b1c059a5bd8d781320c9f5189de8293693b7d95da54befddaa54abf52
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG COMMON_WORKDIR=/app
ARG OS_SECURITY_UPDATE_EPOCH=2026-09-10
ARG MIN_LINUX_LIBC_DEV_VERSION=5.15.0-191.201

WORKDIR ${COMMON_WORKDIR}

# vLLM compiles GPU kernels at runtime, so the final image must retain current
# userspace kernel headers even though it never loads host kernel modules.
RUN test -n "${OS_SECURITY_UPDATE_EPOCH}" && \
    apt-get update && \
    apt-get install -y --no-install-recommends git jq linux-libc-dev && \
    installed_linux_libc_dev_version="$(dpkg-query -W -f='${Version}' linux-libc-dev)" && \
    dpkg --compare-versions \
        "${installed_linux_libc_dev_version}" ge "${MIN_LINUX_LIBC_DEV_VERSION}" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${COMMON_WORKDIR}/vllm-omni

# Step 2: Copy vllm-omni code and install
COPY . ${COMMON_WORKDIR}/vllm-omni
ARG VLLM_OMNI_VERSION_OVERRIDE
ARG VLLM_OMNI_SOURCE_SHA
LABEL org.opencontainers.image.revision="${VLLM_OMNI_SOURCE_SHA}" \
      org.opencontainers.image.version="${VLLM_OMNI_VERSION_OVERRIDE}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
RUN test -n "${VLLM_OMNI_VERSION_OVERRIDE}" && \
    test -n "${VLLM_OMNI_SOURCE_SHA}" && \
    cd ${COMMON_WORKDIR}/vllm-omni && \
    VLLM_OMNI_VERSION_OVERRIDE="${VLLM_OMNI_VERSION_OVERRIDE}" \
    uv pip install --python "$(python3 -c 'import sys; print(sys.executable)')" --no-cache-dir "."

RUN ln -sf /usr/bin/python3 /usr/bin/python

ENTRYPOINT []
